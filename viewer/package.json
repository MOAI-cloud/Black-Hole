{
  "name": "gargantua-interactive-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "test:lensing": "node tests/run-lensing.mjs",
    "start": "node ../play.mjs",
    "renderer:configure": "cmake -S .. -B ../build",
    "renderer:build": "cmake --build ../build --config Release --parallel",
    "renderer:rebuild": "npm run renderer:configure && npm run renderer:build",
    "dev": "concurrently -k -n api,web -c cyan,yellow \"npm:api\" \"npm:web\"",
    "api": "node server/render-server.mjs",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test server/ tests/",
    "serve": "npm run build && node server/render-server.mjs"
  },
  "dependencies": {
    "three": "0.167.1"
  },
  "devDependencies": {
    "@types/node": "18.19.123",
    "@types/three": "0.167.2",
    "concurrently": "8.2.2",
    "typescript": "5.6.3",
    "vite": "6.4.2"
  }
}
